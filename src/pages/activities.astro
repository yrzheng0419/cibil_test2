---
import BaseLayout from '../layouts/BaseLayout.astro';
import DataIsland from '../components/DataIsland.astro';
import Bi from '../components/Bi.astro';
import { fetchAllSheets } from '../lib/fetchSheets';
import { renderActivities } from '../lib/render/gallery';
import { en, zh } from '../i18n';

const data = await fetchAllSheets();
---

<BaseLayout title={`${en.activities.heading} · CIBI Lab`}>
  <section class="mx-auto max-w-5xl px-5 py-16">
    <h1 class="mb-10 text-3xl font-medium" data-animate data-anim-y="10" data-anim-duration="400">
      <Bi en={en.activities.heading} zh={zh.activities.heading} />
    </h1>

    <div id="activities" class="activities-timeline" set:html={renderActivities(data.gallery, 'en')}></div>
  </section>

  <DataIsland data={data} />
</BaseLayout>

<script>
  import { renderActivities } from '../lib/render/gallery';
  import { getLang } from '../scripts/langToggle';
  import type { SheetData } from '../types';

  let data: SheetData | null = null;

  function rerender() {
    const el = document.getElementById('activities');
    if (el && data) el.innerHTML = renderActivities(data.gallery, getLang());
  }

  document.addEventListener('cibi:data', (e) => {
    data = (e as CustomEvent<SheetData>).detail;
    rerender();
  });
  document.addEventListener('cibi:lang', rerender);
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import DataIsland from '../components/DataIsland.astro';
import Bi from '../components/Bi.astro';
import { fetchAllSheets } from '../lib/fetchSheets';
import { renderMembers, type TeamSection } from '../lib/render/members';
import { en, zh } from '../i18n';

const data = await fetchAllSheets();

const sections: { key: TeamSection; en: string; zh: string }[] = [
  { key: 'msc', en: en.team.msc, zh: zh.team.msc },
  { key: 'phd', en: en.team.phd, zh: zh.team.phd },
  { key: 'alumni', en: en.team.alumni, zh: zh.team.alumni },
  { key: 'ra', en: en.team.ra, zh: zh.team.ra },
];
---

<BaseLayout title={`${en.team.heading} · CIBI Lab`}>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <h1 class="mb-10 text-3xl font-medium" data-animate data-anim-y="10" data-anim-duration="400">
      <Bi en={en.team.heading} zh={zh.team.heading} />
    </h1>

    {
      sections.map((s) => (
        <div class="mb-12">
          <h2
            class="mb-5 text-xs font-medium tracking-wider text-brand-mid uppercase"
            data-animate
            data-anim-y="10"
            data-anim-duration="350"
          >
            <Bi en={s.en} zh={s.zh} />
          </h2>
          <div
            id={`team-${s.key}`}
            class="flex flex-wrap gap-6"
            set:html={renderMembers(data.members, s.key, 'en')}
          />
        </div>
      ))
    }
  </section>

  <DataIsland data={data} />
</BaseLayout>

<script>
  import { renderMembers, type TeamSection } from '../lib/render/members';
  import { getLang } from '../scripts/langToggle';
  import type { SheetData } from '../types';

  const SECTIONS: TeamSection[] = ['msc', 'phd', 'alumni', 'ra'];
  let data: SheetData | null = null;

  function rerenderAll() {
    if (!data) return;
    const lang = getLang();
    for (const key of SECTIONS) {
      const el = document.getElementById(`team-${key}`);
      if (el) el.innerHTML = renderMembers(data.members, key, lang);
    }
  }

  document.addEventListener('cibi:data', (e) => {
    data = (e as CustomEvent<SheetData>).detail;
    rerenderAll();
  });
  document.addEventListener('cibi:lang', rerenderAll);
</script>
